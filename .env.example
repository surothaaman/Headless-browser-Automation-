# Copy this file to .env and replace the token with a locally generated value.
# Keep .env out of Git. The API and CLI load this same project-root file.
CSE_ACCESS_TOKEN=REPLACE_WITH_A_RANDOM_LOCAL_TOKEN
CSE_API_URL=http://127.0.0.1:8000
CSE_PUBLIC_KEY_PATH=keys/server_public.pem
CSE_PRIVATE_KEY_PATH=keys/server_private.pem

# Optional: used to fill the portal password field during simulator login.
# Keep the real value only in the ignored project-root .env file.
PORTAL_PASSWORD=
